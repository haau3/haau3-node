{
  "name": "@haau3/sdk",
  "version": "0.3.9",
  "description": "TypeScript SDK for the haau3 platform API: appointment slots from SMART Scheduling Links publishers, Medicare Advantage and ACA Marketplace plan benefits, medication list reconciliation, RxNorm, LOINC and ICD-10-CM terminology, the CMS National Provider Directory and FHIR Questionnaires, as typed calls.",
  "license": "MIT",
  "homepage": "https://platform.haau3.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haau3/haau3-node.git"
  },
  "bugs": {
    "url": "https://github.com/haau3/haau3-node/issues"
  },
  "keywords": [
    "haau3",
    "smart-scheduling-links",
    "appointment-scheduling",
    "scheduling",
    "medical-benefits",
    "medicare-advantage",
    "aca-marketplace",
    "insurance-plan",
    "medication-reconciliation",
    "rxnorm",
    "loinc",
    "icd-10-cm",
    "terminology",
    "provider-directory",
    "npi",
    "fhir",
    "fhir-r4",
    "healthcare",
    "healthcare-api",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "fetch-spec": "tsx scripts/fetch-spec.ts",
    "generate": "tsx scripts/generate.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check:package": "publint --strict && attw --pack .",
    "check:public-text": "tsx scripts/check-public-text.ts"
  },
  "dependencies": {
    "@types/fhir": "~0.0.44"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "openapi-typescript": "7.13.0",
    "publint": "^0.3.25",
    "tsdown": "0.23.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
